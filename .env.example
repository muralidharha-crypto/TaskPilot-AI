# TaskPilot AI - Environment Configuration

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=taskpilot-production-secret-change-in-prod-xyz123
PORT=5000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=sqlite:///instance/taskpilot.db

# AI Provider Configuration (Optional - TaskPilot has built-in deterministic autonomous agent fallback)
# Supported: gemini, openai, mock
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Application Settings
DEMO_MODE=true
MAX_DAILY_HOURS=8
DEFAULT_EVENING_HOURS=3
